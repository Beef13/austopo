# MapTiler API key for the primary "Topo" (Outdoor) basemap.
# Get a free key at https://cloud.maptiler.com/account/keys/ and paste it below.
# In the MapTiler dashboard, restrict the key to your domains
# (e.g. austopo.vercel.app and localhost) since it is exposed to the browser.
#
# Without this key the app still works and falls back to OpenTopoMap.
VITE_MAPTILER_KEY=
